diff --git a/kitty/macos.conf b/kitty/macos.conf
index ef65018..0e7c694 100644
--- a/kitty/macos.conf
+++ b/kitty/macos.conf
@@ -10,6 +10,30 @@
 # Open new tab in current window
 # map ctrl+shift+t launch --cwd=current --type=tab
 
+# Splits layout is required for hsplit/vsplit launch locations
+enabled_layouts splits,stack
+
+# Open short window as horizontal split in current window
+map cmd+enter launch --cwd=current --type=window --location=hsplit --bias=20
+
+# Open vertical split in current window
+map cmd+shift+enter launch --cwd=current --type=window --location=vsplit
+
+# Switch window split focus
+map cmd+up neighboring_window up
+map cmd+down neighboring_window down
+map cmd+left neighboring_window left
+map cmd+right neighboring_window right
+
+# Resize window splits
+map cmd+ctrl+j resize_window shorter 3
+map cmd+ctrl+k resize_window taller 3
+map cmd+ctrl+h resize_window narrower
+map cmd+ctrl+l resize_window wider
+
+# reset all windows in the tab to default sizes
+map cmd+ctrl+home resize_window reset
+
 # ---------------------------------------------------------
 
 
@@ -26,3 +50,14 @@ hide_window_decorations no
 
 # Quick kitty when last terminal window closed
 macos_quit_when_last_window_closed no
+
+# 탭 n번으로 이동 (기본값은 탭 안의 n번째 창 first_window...)
+map cmd+1 goto_tab 1
+map cmd+2 goto_tab 2
+map cmd+3 goto_tab 3
+map cmd+4 goto_tab 4
+map cmd+5 goto_tab 5
+map cmd+6 goto_tab 6
+map cmd+7 goto_tab 7
+map cmd+8 goto_tab 8
+map cmd+9 goto_tab 9
diff --git a/zsh/zshrc b/zsh/zshrc
index 1e249e0..1441639 100644
--- a/zsh/zshrc
+++ b/zsh/zshrc
@@ -54,6 +54,9 @@ nvim-fuzy-find() {
 # Alternatives: https://gist.github.com/elijahmanor/b279553c0132bfad7eae23e34ceb593b
 # ----------------------------------------
 
+# Machine-local settings (untracked)
+[[ ! -f "${ZDOTDIR:-$HOME}/local.zsh" ]] || source "${ZDOTDIR:-$HOME}/local.zsh"
+
 # Starship command prompt theme
 eval "$(starship init zsh)"
 
